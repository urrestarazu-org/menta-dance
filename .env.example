# Copy this file to .env and replace every placeholder with a local secret.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_APP_USER=menta_app
MYSQL_APP_PASSWORD=replace-with-a-local-application-password
ENVIRONMENT=local
# Local SMTP capture (Mailpit); no credentials are required.
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Signs payment-proof links. Required and without a default, so the API will not
# start without it (unless the `demo` profile is active, which brings its own
# demo-only value). Use any long random local value; never reuse it elsewhere.
BILLING_BANK_TRANSFER_PROOF_TOKEN_SECRET=replace-with-a-long-random-local-secret

# Where Mercado Pago sends the browser after the buyer pays or gives up: the BFF return
# page (`GET /compras/retorno`). Locally the BFF listens on port 8080.
# Empty means the preference carries no back URLs and the buyer stays on the provider's page.
BILLING_MERCADOPAGO_CHECKOUT_BACK_URL=http://localhost:8080/compras/retorno

# Para el BFF y Redis no hace falta configurar nada en local: usan `localhost:8081` y `localhost:6379`.
# En `prod`, además hay que reemplazar obligatoriamente los defaults inseguros:
# la aplicación rechaza el arranque en perfiles `prod`, `production` o `staging` si esas claves conservan los valores de desarrollo.
# También conviene definir `AUTH_TRUSTED_PROXY_CIDRS` y `MENTA_TRUSTED_PROXY_CIDRS` con las redes reales de NGINX/BFF, no el rango Docker por defecto.

#AUTH_JWT_BASE64_SECRET=<base64-de-32-bytes-o-mas>
#AUTH_ACTIVATION_DELIVERY_KEY=<clave-AES-distinta>
#AUTH_PASSWORD_RESET_DELIVERY_KEY=<clave-AES-distinta>
#BILLING_WEBHOOK_MERCADOPAGO_HMAC_SECRET=<secreto-distinto>
