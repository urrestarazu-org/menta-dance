# Copy this file to .env and replace every placeholder with a local secret.
# The .env file is read by scripts/dev.sh, by Docker Compose and by `bootRun`
# (api/app and bff). It is git-ignored: never commit it, never paste it in chats or tickets.
# Changes are only picked up on startup: run `./scripts/dev.sh restart` after editing it.

# --- Local infrastructure -----------------------------------------------------------------

# Root password of the local MySQL container. Choose any local value; it is only used
# when the container is created (to change it later, recreate the volume).
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
# Application user created in the MySQL container and used by the API. Default: menta_app.
MYSQL_APP_USER=menta_app
# Password of that application user. Choose any local value.
MYSQL_APP_PASSWORD=replace-with-a-local-application-password
# Selects the Docker Compose layout used by infra/docker/manage.sh. Only `local` or
# `production` are accepted; `production` also requires TLS certificates. Keep `local` here.
ENVIRONMENT=local

# Local SMTP capture (Mailpit); no credentials are required. Mailpit receives every email
# the API sends (for example the account activation link); read them at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# Host port of the Mailpit web UI in the root and infra/docker/app compose files.
# `scripts/dev.sh` uses infra/docker/database, which reads MAILPIT_WEB_HOST_PORT instead.
MAILPIT_WEB_PORT=8025

# --- Billing ------------------------------------------------------------------------------

# Signs payment-proof links. Required and without a default, so the API will not
# start without it (unless the `demo` profile is active, which brings its own
# demo-only value). Use any long random local value; never reuse it elsewhere.
BILLING_BANK_TRANSFER_PROOF_TOKEN_SECRET=replace-with-a-long-random-local-secret

# Where Mercado Pago sends the browser after the buyer pays or gives up: the BFF return
# page (`GET /compras/retorno`). Locally the BFF listens on port 8080.
# Empty means the preference carries no back URLs and the buyer stays on the provider's page.
# For the real Mercado Pago sandbox (see below) the same default is used, but it is unconfirmed
# whether Mercado Pago honours a plain `http://localhost` URL: see issue #515 and the
# "Sandbox real de Mercado Pago" section of docs/26-LOCAL-DEV-SETUP-HOWTO.md.
BILLING_MERCADOPAGO_CHECKOUT_BACK_URL=http://localhost:8080/compras/retorno

# --- Real Mercado Pago sandbox (optional) -------------------------------------------------
# Only needed to test a purchase against the real Mercado Pago sandbox instead of the local
# simulator. Uncomment and fill all four, then run with the `demo` profile:
#   SPRING_PROFILES_ACTIVE=demo ./scripts/dev.sh start
# Step by step: "Sandbox real de Mercado Pago" in docs/26-LOCAL-DEV-SETUP-HOWTO.md.
# Where each value comes from, in the Mercado Pago developer console (your test application):
#
# Access token of the TEST SELLER user, used to create payment preferences and read payments.
# Console: "Credenciales de prueba".
#BILLING_MERCADOPAGO_ACCESS_TOKEN=<access-token-of-the-test-seller>
#
# User ID of the TEST SELLER (about 10 digits). The API compares it with the `collector_id`
# Mercado Pago returns for each payment; a mismatch leaves the payment in
# RECONCILIATION_REQUIRED. It is the `id` returned by `GET https://api.mercadopago.com/users/me`
# called with the access token above (Authorization: Bearer). It is NOT the application ID
# (16 digits, the one in the console URL).
#BILLING_MERCADOPAGO_MERCHANT_ACCOUNT_ID=<user-id-of-the-test-seller>
#
# Public HTTPS URL where Mercado Pago delivers the payment webhook. Locally it is a temporary
# tunnel to the API (port 8081), for example `cloudflared tunnel --url http://localhost:8081`.
# The tunnel URL changes every time the tunnel restarts: update this value, restart the API and
# update the webhook URL in the console (Webhooks > Configurar notificaciones).
#BILLING_MERCADOPAGO_NOTIFICATION_URL=https://<tunnel-host>/api/v1/billing/payments/mercadopago/webhook
#
# Secret that signs the `x-signature` header of every webhook. Console: Webhooks > Configurar
# notificaciones > "Clave secreta" of the tab whose URL delivers the events. With a test seller,
# events arrive as "Modo productivo", so use that tab's secret. Without a valid value the API
# rejects the webhook. Also listed below for production.
#BILLING_WEBHOOK_MERCADOPAGO_HMAC_SECRET=<webhook-secret-from-the-console>

# Para el BFF y Redis no hace falta configurar nada en local: usan `localhost:8081` y `localhost:6379`.
# En `prod`, además hay que reemplazar obligatoriamente los defaults inseguros:
# la aplicación rechaza el arranque en perfiles `prod`, `production` o `staging` si esas claves conservan los valores de desarrollo.
# También conviene definir `AUTH_TRUSTED_PROXY_CIDRS` y `MENTA_TRUSTED_PROXY_CIDRS` con las redes reales de NGINX/BFF, no el rango Docker por defecto.

#AUTH_JWT_BASE64_SECRET=<base64-de-32-bytes-o-mas>
#AUTH_ACTIVATION_DELIVERY_KEY=<clave-AES-distinta>
#AUTH_PASSWORD_RESET_DELIVERY_KEY=<clave-AES-distinta>
#BILLING_WEBHOOK_MERCADOPAGO_HMAC_SECRET=<secreto-distinto>
