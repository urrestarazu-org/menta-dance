# Variables de producción (VPS DonWeb, #589 / ADR-0045).
#
# Se copia a /opt/menta/.env en el servidor (chmod 600, dueño deploy) y se completa ahí.
# Este archivo solo trae los NOMBRES: nunca pongas valores reales en el repositorio.
# Las marcadas "obligatoria" hacen fallar `docker compose up` (o el arranque de la API) si faltan.

# --- Imágenes (las escribe el deploy, #593; el digest sale de GHCR) -------------------------
# Formato: sha256:<64 hex>
API_DIGEST=
BFF_DIGEST=

# --- MySQL -----------------------------------------------------------------------------------
# obligatoria
MYSQL_ROOT_PASSWORD=
# obligatoria
MYSQL_APP_PASSWORD=
# MYSQL_APP_USER=menta_app

# --- Secretos de la API (el perfil prod rechaza los valores de desarrollo) -----------------------
# obligatoria; base64 de 32 bytes o más
AUTH_JWT_BASE64_SECRET=
# obligatoria; clave AES-GCM
AUTH_ACTIVATION_DELIVERY_KEY=
# obligatoria; clave AES-GCM, distinta de la de activación
AUTH_PASSWORD_RESET_DELIVERY_KEY=
# obligatoria
BILLING_WEBHOOK_MERCADOPAGO_HMAC_SECRET=
# obligatoria
BILLING_BANK_TRANSFER_PROOF_TOKEN_SECRET=

# --- Correo saliente -------------------------------------------------------------------------
# obligatoria
SMTP_HOST=
# obligatoria
SMTP_PORT=
# SMTP_AUTH=false
# SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Mercado Pago ----------------------------------------------------------------------------
# Sin el token la API arranca igual, pero no puede operar pagos: no hay validación de arranque.
BILLING_MERCADOPAGO_ACCESS_TOKEN=
# BILLING_MERCADOPAGO_NOTIFICATION_URL=
# BILLING_MERCADOPAGO_CHECKOUT_BACK_URL=

# --- Transferencia bancaria ------------------------------------------------------------------
BILLING_BANK_TRANSFER_CBU=
BILLING_BANK_TRANSFER_ALIAS=
BILLING_BANK_TRANSFER_HOLDER=
BILLING_BANK_TRANSFER_CUIT=

# --- Videos (Bunny.net) ----------------------------------------------------------------------
APP_CDN_BUNNYNET_PULLZONEHOSTNAME=
APP_CDN_BUNNYNET_VIDEOLIBRARYID=

# --- Opcionales con valor por defecto en el compose --------------------------------------------
# Base de los enlaces de los correos
# PUBLIC_BASE_URL=https://mentadance.com
# Subred de Compose = proxies de confianza de API y BFF
# MENTA_NETWORK_SUBNET=172.29.250.0/24
# API_JAVA_OPTS=
# BFF_JAVA_OPTS=
