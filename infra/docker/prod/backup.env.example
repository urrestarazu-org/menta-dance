# Variables de backup.sh (VPS DonWeb, #594 / ADR-0045).
#
# Se copia a /opt/menta/backup.env en el servidor (chmod 600, dueño deploy) y se completa ahí.
# Este archivo solo trae los NOMBRES: nunca pongas valores reales en el repositorio.
# El formato es el de `docker --env-file`: una variable por línea, SIN comillas y sin `export`.
# rclone lee las variables RCLONE_CONFIG_*; backup.sh lee las BACKUP_*.

# --- Almacenamiento S3-compatible (fuera del VPS) ------------------------------------------------
RCLONE_CONFIG_OFFSITE_TYPE=s3
# Según el proveedor: Cloudflare, Other (Backblaze B2 y la mayoría de los S3-compatibles), AWS, ...
RCLONE_CONFIG_OFFSITE_PROVIDER=
# Endpoint S3 del proveedor, p. ej. https://<cuenta>.r2.cloudflarestorage.com o
# https://s3.<región>.backblazeb2.com
RCLONE_CONFIG_OFFSITE_ENDPOINT=
# Clave de acceso restringida a ESTE bucket (no la de la cuenta)
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# Algunos proveedores la exigen (p. ej. Backblaze); Cloudflare R2 usa "auto"
# RCLONE_CONFIG_OFFSITE_REGION=

# --- Cifrado del lado del cliente (rclone crypt) --------------------------------------------------
# Los backups tienen datos personales: se cifran antes de salir del servidor. El remoto cifrado apunta
# al bucket y a una carpeta: <bucket>/menta.
RCLONE_CONFIG_OFFSITECRYPT_TYPE=crypt
RCLONE_CONFIG_OFFSITECRYPT_REMOTE=offsite:<BUCKET>/menta
# Las dos claves van "ofuscadas" con `docker run --rm rclone/rclone:1.75.2 obscure '<clave>'`. Guardá
# las claves en texto plano en un gestor de contraseñas FUERA del servidor: sin ellas los backups no
# se pueden descifrar.
RCLONE_CONFIG_OFFSITECRYPT_PASSWORD=
RCLONE_CONFIG_OFFSITECRYPT_PASSWORD2=

# --- Retención (opcionales) -----------------------------------------------------------------------
# Copias que se conservan en el VPS de cada tipo (el disco es chico); mínimo 2
# BACKUP_LOCAL_KEEP=7
# Días que se conservan fuera del VPS; mínimo 7
# BACKUP_REMOTE_RETENTION_DAYS=30

# --- Aviso de ejecución (opcional) -----------------------------------------------------------------
# URL de ping de un monitor tipo healthchecks.io: se llama al terminar bien, y con /fail al fallar.
# Si el backup deja de correr, el monitor avisa por mail aunque nadie mire el servidor.
# BACKUP_PING_URL=
