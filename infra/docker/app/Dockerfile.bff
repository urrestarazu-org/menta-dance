# Multi-stage build for BFF module
# Stage 1: Build
FROM gradle:8.12.0-jdk21 AS build

WORKDIR /app

# Copy Gradle wrapper and dependencies first (better caching)
COPY gradle gradle
COPY gradlew .
COPY gradle.properties .
COPY settings.gradle.kts .
COPY build.gradle.kts .
COPY gradle/libs.versions.toml gradle/

# Copy build files for all modules (needed for Gradle configuration)
COPY bff bff/
COPY api api/
COPY android/build.gradle.kts android/
COPY config config/
COPY scripts scripts/

# Build only the BFF module
RUN ./gradlew :bff:bootJar --no-daemon --parallel

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Create non-root user
RUN addgroup -g 1000 menta && \
    adduser -D -u 1000 -G menta menta

# Copy JAR from build stage
COPY --from=build /app/bff/build/libs/bff-*.jar /app/bff.jar

# Copy static resources (Thymeleaf templates, CSS, JS)
COPY --from=build /app/bff/src/main/resources /app/resources

# Change ownership
RUN chown -R menta:menta /app

# Switch to non-root user
USER menta

# Expose BFF port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=60s \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# JVM optimization flags (can be overridden via JAVA_OPTS environment)
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"

# Run application
CMD ["sh", "-c", "exec java $JAVA_OPTS -jar /app/bff.jar"]
