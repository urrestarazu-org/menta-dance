# Multi-stage build for API module
# Stage 1: Build
FROM gradle:8.12.0-jdk21 AS build

WORKDIR /app

# Copy Gradle wrapper and dependencies first (better caching)
COPY gradle gradle
COPY gradlew .
COPY gradle.properties .
COPY settings.gradle.kts .
COPY build.gradle.kts .
COPY gradle/libs.versions.toml gradle/

# Copy build files for all modules (needed for Gradle configuration)
COPY api api/
COPY bff/build.gradle.kts bff/
COPY android/build.gradle.kts android/
COPY config config/
COPY scripts scripts/

# Build only the API app module
RUN ./gradlew :api:app:bootJar --no-daemon --parallel

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Create non-root user
RUN addgroup -g 1000 menta && \
    adduser -D -u 1000 -G menta menta

# Copy JAR from build stage
COPY --from=build /app/api/app/build/libs/menta-dance-api.jar /app/app.jar

# Change ownership
RUN chown -R menta:menta /app

# Switch to non-root user
USER menta

# Expose API port
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=60s \
    CMD wget --quiet --tries=1 --spider http://localhost:8081/actuator/health || exit 1

# JVM optimization flags (can be overridden via JAVA_OPTS environment)
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"

# Run application
CMD ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
