meta {
  name: Publish Course
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/admin/virtual/courses/{{journeyCourseId}}/publish
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("administrator publishes the complete course", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().courseId).to.equal(bru.getVar("journeyCourseId"));
    expect(res.getBody().status).to.equal("PUBLISHED");
  });
}

assert {
  res.status: eq 200
}
