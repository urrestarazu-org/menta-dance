meta {
  name: Get Planned Protected Lesson Stream - Subscription Required
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/virtual/lessons/{{plannedProtectedLessonId}}/stream
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("Status is 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("The authenticated student has no entitlement before checkout", function() {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody().code).to.equal("LESSON_FORBIDDEN_SUBSCRIPTION_REQUIRED");
    expect(res.getBody().stream).to.not.exist;
    expect(res.getBody().url).to.not.exist;
    expect(res.getBody().videoId).to.not.exist;
  });
}

docs {
  Before checkout, the planned course denies its protected lesson exactly
  like the unplanned one — a plan link alone grants nothing; only a current
  Billing entitlement does (design.md A6). Run "Create Subscription Checkout"
  through "Poll Subscription Activated" next to fulfil that entitlement.
}

assert {
  res.status: eq 403
}
