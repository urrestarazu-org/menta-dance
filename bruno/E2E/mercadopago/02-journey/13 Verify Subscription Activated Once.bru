meta {
  name: Verify Subscription Activated Once
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/billing/subscriptions
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  // Wait for at least one WebhookInboxReconciler tick (default 5000ms) to
  // process both the original and the duplicate delivery.
  await new Promise((resolve) => setTimeout(resolve, 8000));
}

body:json {
  {
    "planId": "{{planId}}",
    "paymentMethod": "MERCADO_PAGO",
    "idempotencyKey": "{{subscriptionIdempotencyKey}}"
  }
}

docs {
  Replays the primary student's checkout with its own idempotencyKey — same
  replay-returns-current-status contract used to poll the mismatch outcome
  for the other student. An approved, matching provider result activates
  the subscription exactly once even though the webhook was delivered
  twice (previous two steps).
}

tests {
  test("worker fulfillment activated the subscription exactly once", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("ACTIVE");
  });
}

assert {
  res.status: eq 201
  res.body.status: eq ACTIVE
}
