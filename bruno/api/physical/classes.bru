meta {
  name: List Classes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/classes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

params:query {
  date: 2026-07-24
  instructorId: ~
}

docs {
  List scheduled physical classes.
  Optional filters: date, instructorId
  Requires authentication.
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
