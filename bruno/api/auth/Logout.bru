meta {
  name: Auth Logout
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  auth: bearer
}

headers {
  X-Refresh-Token: {{refreshToken}}
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Revoke the active refresh by presenting both credentials: the access token
  in Authorization: Bearer and the opaque refresh only in X-Refresh-Token.
  The endpoint does not accept refreshToken in a JSON body.

  Atomic in the same MySQL transaction:
    - mark refresh.status = REVOKED;
    - INSERT common_outbox_events (event_type=UserLoggedOut).

  Errors are RFC 9457 application/problem+json and never return either token.

  Variable contract:
    Auth.Refresh.bru (or Auth.Login.bru if you skipped refresh) must
    populate {{refreshToken}} and {{authToken}} first.
}

assert {
  res.status: eq 204
}

tests {
  test("Body is empty (No Content)", function() {
    expect(res.getBody()).to.equal('');
  }
}
