meta {
  name: Auth Refresh
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  auth: none
}

headers {
  X-Refresh-Token: {{refreshToken}}
}

docs {
  Rotate a refresh token. The opaque value is accepted exclusively in the
  X-Refresh-Token header; it is never accepted from a JSON request body.

  The endpoint atomically:
    - marks the presented refresh as USED;
    - mints a new pair in the same family;
    - publishes common_outbox_events with event_type=RefreshRotated.

  A 4xx/5xx error is RFC 9457 application/problem+json and never includes the
  presented token.

  Variable contract:
    Auth.Login.bru must run first to populate {{refreshToken}}.
}

tests {
  test("Returns new pair", function() {
    expect(res.getBody().access_token).to.be.a('string');
    expect(res.getBody().refresh_token).to.be.a('string');
    expect(res.getBody().refresh_token).to.not.equal(bru.getVar('refreshToken'));
  }
}

assert {
  res.status: eq 200
}
