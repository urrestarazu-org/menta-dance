meta {
  name: List Courses
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/courses
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

params:query {
  page: 0
  size: 20
  sort: createdAt,desc
}

docs {
  List all available online courses.
  Requires authentication.
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
