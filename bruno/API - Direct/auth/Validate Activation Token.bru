meta {
  name: Validate Activation Token
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/activate/{{activationToken}}
  auth: none
}

docs {
  Validates a runtime-only activation token without consuming it or changing the
  account. Never save this token in an environment file or commit it.
  An account that registered itself returns 204 with no body. An account created
  by an administrator returns 200 with
  { "passwordRequired": true }: the holder must choose a password when activating.
}

assert {
  res.status: in [200, 204]
}
