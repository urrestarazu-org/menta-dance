meta {
  name: Activate Account - Reused Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/activate
  body: json
  auth: none
}

body:json {
  {
    "token": "{{activationToken}}"
  }
}

tests {
  test("Reused token returns a generic RFC 9457 problem", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal('ACTIVATION_TOKEN_INVALID');
  });
}

assert {
  res.status: eq 400
}
