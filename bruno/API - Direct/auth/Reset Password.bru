meta {
  name: Reset Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "NewSecurePass1"
  }
}

docs {
  Paste the opaque token from a local Mailpit message into the runtime-only
  `resetToken` variable. Never save it in an environment file or commit it.
  A valid, unused, unexpired token returns 200; not-found tokens return 404,
  expired/already-used tokens return 410, and a weak or repeated password
  returns 400 — all as RFC 9457 problems.
}

assert {
  res.status: eq 200
}
