meta {
  name: Activate Account
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/activate
  body: json
  auth: none
}

body:json {
  {
    "token": "{{activationToken}}",
    "password": "{{activationPassword}}"
  }
}

docs {
  Paste the opaque token from a local Mailpit message into the runtime-only
  `activationToken` variable. Never save it in an environment file or commit it.
  This POST consumes the token and activates the account; use Validate Activation
  Token first when testing the read-only GET contract.
  A valid token returns 204; expired, reused, or invalid tokens return the same
  RFC 9457 ACTIVATION_TOKEN_INVALID problem.
  `password` is only used for an account created by an administrator
  (POST /api/v1/admin/users): set the runtime-only `activationPassword` variable
  to the password the holder chooses (8+ characters, an uppercase letter and a
  digit). Without it that account answers 400 PASSWORD_REQUIRED, with a weak one
  400 WEAK_PASSWORD, and the token is not consumed. For an account that
  registered itself the field is ignored. Never save the password in an
  environment file or commit it.
}

assert {
  res.status: eq 204
}
