meta {
  name: Auth Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const accessToken = res.body.access_token;
    const refreshToken = res.getHeader("x-refresh-token");

    if (accessToken && refreshToken) {
      bru.setVar("authToken", accessToken);
      bru.setVar("refreshToken", refreshToken);
    }
  }
}

docs {
  Authenticate with the environment fixture and capture the token pair into
  runtime-only variables for the refresh and logout requests.
  The end-to-end happy path uses valid credentials while the auth service is
  available and its reconciler is current.

  Success contract:
    body   → { access_token, token_type, expires_in }
    header → X-Refresh-Token: <opaque token>

  The refresh token is NEVER returned in the JSON body.

  Error contract:
    401 INVALID_CREDENTIALS → wrong or unknown email
    423 USER_LOCKED          → account locked via /admin
    503 AUTH_DEGRADED        + Retry-After: 30 → outbox reconciler lagging

  Prerequisite: run Register User once so the same STUDENT fixture exists.
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Body carries the access token shape", function() {
    expect(res.getBody().access_token).to.be.a('string');
    expect(res.getBody().token_type).to.equal('Bearer');
    expect(res.getBody().expires_in).to.be.a('number');
  });

  test("Refresh token is returned only in the header", function() {
    expect(res.getHeader("x-refresh-token")).to.be.a('string').and.not.empty;
    expect(res.getBody()).to.not.have.property('refresh_token');
  });

  test("access_token looks like JWT", function() {
    expect(res.getBody().access_token.split('.').length).to.equal(3);
  });
}

assert {
  res.status: eq 200
}
