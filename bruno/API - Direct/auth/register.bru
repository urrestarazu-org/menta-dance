meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/users/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "role": "STUDENT"
  }
}

docs {
  Public registration is temporarily unavailable while auth-account-activation
  is completed. This request verifies the explicit 503 safeguard, preventing
  the incomplete activation flow from reaching placeholder infrastructure.
}

tests {
  test("Status is 503 while activation infrastructure is incomplete", function() {
    expect(res.getStatus()).to.equal(503);
  });
}

assert {
  res.status: eq 503
}
