meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "role": "STUDENT"
  }
}

docs {
  Creates a PENDING_ACTIVATION account and returns only a generic acknowledgement.
  Retrieve the activation link from local Mailpit (http://localhost:8025) without
  persisting its opaque token in this collection or environment file.
}

tests {
  test("Status is 202 Accepted", function() {
    expect(res.getStatus()).to.equal(202);
  });
}

assert {
  res.status: eq 202
}
