meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/users/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "role": "STUDENT"
  }
}

docs {
  Register the STUDENT fixture used by the login request.

  Public registration accepts only the STUDENT role. INSTRUCTOR and ADMIN
  provisioning must use a privileged administrative flow; changing this
  request to either role is not a supported public registration scenario.

  The response ID is serialized as a UUID string.
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Response has a UUID user ID", function() {
    expect(res.getBody().id).to.be.a('string');
    expect(res.getBody().id).to.match(
      /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
    );
  });
}

assert {
  res.status: eq 201
}
