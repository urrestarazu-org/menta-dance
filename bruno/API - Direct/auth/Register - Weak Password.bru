meta {
  name: Register User - Weak Password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "debil",
    "firstName": "Ana",
    "lastName": "Prueba",
    "phone": "+5491100000000",
    "role": "STUDENT"
  }
}

docs {
  La contraseña no cumple la política (mínimo 8 caracteres, una mayúscula y un
  número): 400 WEAK_PASSWORD como problema RFC 9457. Se valida antes de consultar
  si el email existe, así que la respuesta es la misma para un email nuevo y uno
  ya registrado, y no crea ninguna cuenta.
}

tests {
  test("Weak password is a 400 WEAK_PASSWORD problem", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal('WEAK_PASSWORD');
  });
}

assert {
  res.status: eq 400
}
