meta {
  name: Correct Payment (Admin)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/admin/billing/payments/{{paymentId}}/corrections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "decision": "APPROVED",
    "reason": "Transferencia confirmada por el banco fuera del webhook",
    "evidence": "Comprobante bancario adjunto por email, ticket #4521"
  }
}

docs {
  #33, US-BILLING-005 (D9/D4/C7/C11/C1). Requires an ADMIN bearer token and a
  target paymentId currently PENDING/RECONCILIATION_REQUIRED.

  Both reason and evidence are mandatory regardless of decision (400 via the
  existing @NotBlank path if either is blank/absent). On success: the payment
  transitions to a terminal state, the tied reconciliation task is marked
  resolved, and one billing_audit_log row is written with
  reason = "{reason} | evidencia: {evidence}" (D4). Deliberately does NOT
  send a buyer email (out of scope for this endpoint — see US-BILLING-005
  "Decisiones de implementación").

  Error contract:
    400                              → reason or evidence missing/blank
    403                              → caller is not ADMIN
    404 PAYMENT_NOT_FOUND            → paymentId does not exist
    409 ILLEGAL_PAYMENT_STATE_TRANSITION → payment is not RECONCILIATION_REQUIRED
}

tests {
  test("Applies the correction", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

assert {
  res.status: eq 200
}
