meta {
  name: List Pending Verification Payments
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/admin/billing/payments?status=PENDING&substatus=AWAITING_MANUAL_VERIFICATION&page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

params:query {
  status: PENDING
  substatus: AWAITING_MANUAL_VERIFICATION
  page: 0
  size: 20
}

docs {
  #33, US-BILLING-005 (D3). Requires an ADMIN bearer token. Returns the
  bank-transfer payments awaiting manual verification, oldest-first.

  size above 50 is rejected with 400 — never clamped (tasks.md Deviation #1).

  Success contract (200):
    { items: [{ paymentId, userId, targetModality, targetReference, amount,
                 currency, statusType, hasProof, createdAt }],
      page, size, totalElements, totalPages }

  Error contract:
    400 INVALID_REQUEST  → size > 50
    401                   → no access token
    403                   → caller is not ADMIN
}

tests {
  test("Returns a paginated, oldest-first list", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("items");
    expect(res.getBody()).to.have.property("page");
  });
}

assert {
  res.status: eq 200
}
