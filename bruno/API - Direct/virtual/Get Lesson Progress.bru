meta {
  name: Get Lesson Progress
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/virtual/lessons/{{virtualEntitledLessonId}}/progress
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  if (!bru.getEnvVar("virtualEntitledLessonId") || !bru.getEnvVar("authToken")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("A granted access with no saved row yet returns a default zeroed view", function() {
    expect(res.getBody().positionSeconds).to.be.a("number");
    expect(res.getBody().completed).to.be.a("boolean");
  });
}

docs {
  US-VIRTUAL-005 (#52). Same access cascade as Save Lesson Progress. Run
  Save Lesson Progress first to see a non-zero position here, or run this
  alone against a never-saved lesson to see the default zeroed view
  (position: 0, completed: false) — never a 404 for a granted access.
}
