meta {
  name: Get Unplanned Course Lesson
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/virtual/lessons/{{virtualUnplannedCourseLessonId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getEnvVar("virtualUnplannedCourseLessonId")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("A course absent from every plan is public preview", function() {
    expect(res.getBody().access.preview).to.equal(true);
    expect(res.getBody().access.requiresSubscription).to.equal(false);
    expect(res.getBody().lesson.videoId).to.not.exist;
  });
}

docs {
  US-VIRTUAL-007 public cascade branch: a course absent from every plan is public.
  Set virtualUnplannedCourseLessonId in a local environment provisioned with this fixture.
}
