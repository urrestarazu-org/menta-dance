meta {
  name: Create Virtual Module
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/virtual/courses/{{virtualCourseId}}/modules
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "title": "Módulo 1: Fundamentos"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("virtualModuleId", res.getBody().moduleId);
  }
}

docs {
  US-VIRTUAL-006 escenario 2. `order` is omitted here — appends at the end.

  Success contract: 201 with VirtualModuleManagementResponse.
  Error contract:
    403 COURSE_NOT_OWNED → INSTRUCTOR is not the course's professor
    404 COURSE_NOT_FOUND → courseId does not exist
}

assert {
  res.status: eq 201
}
