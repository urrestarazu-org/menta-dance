meta {
  name: Get Course Progress
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/virtual/courses/{{virtualEntitledCourseId}}/progress
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  if (!bru.getEnvVar("virtualEntitledCourseId") || !bru.getEnvVar("authToken")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Aggregate exposes live counts and percentage", function() {
    expect(res.getBody().completedLessons).to.be.a("number");
    expect(res.getBody().totalLessons).to.be.a("number");
    expect(res.getBody().percentage).to.be.a("number");
  });
}

docs {
  US-VIRTUAL-005 (#52). Requires a CURRENT Billing entitlement for the whole
  course — with NO free/preview exception, unlike lesson-level access
  (design.md decision 5). A student whose only progress is on free/preview
  lessons within the course is still denied with 403
  COURSE_PROGRESS_FORBIDDEN_SUBSCRIPTION_REQUIRED.

  A zero-lesson course returns 200 with percentage: 0, totalLessons: 0,
  resumeLesson: null — never a 404. resumeLesson is the most recently
  saved-position lesson (design.md decision 10).

  Set virtualEntitledCourseId and authenticate as the entitled student.
}
