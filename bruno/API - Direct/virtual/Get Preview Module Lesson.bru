meta {
  name: Get Preview Module Lesson
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/virtual/lessons/{{virtualPreviewModuleLessonId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getEnvVar("virtualPreviewModuleLessonId")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Preview-module content is explicitly safe preview metadata", function() {
    expect(res.getBody().access.preview).to.equal(true);
    expect(res.getBody().access.requiresSubscription).to.equal(false);
    expect(res.getBody().lesson.videoId).to.not.exist;
  });
}

docs {
  US-VIRTUAL-007 public cascade branch: a non-free lesson in an isPreview module is public.
  Set virtualPreviewModuleLessonId in a local environment provisioned with this fixture.
}
