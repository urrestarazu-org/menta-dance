meta {
  name: Get Protected Lesson Stream - Subscription Required
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/virtual/lessons/{{virtualProtectedLessonId}}/stream
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getEnvVar("virtualProtectedLessonId")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("Denied stream is RFC 9457 without a signed URL", function() {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody().code).to.equal("LESSON_FORBIDDEN_SUBSCRIPTION_REQUIRED");
    expect(res.getBody().stream).to.not.exist;
    expect(res.getBody().url).to.not.exist;
    expect(res.getBody().videoId).to.not.exist;
  });
}

docs {
  A protected stream never returns a capability to an anonymous or non-entitled caller.
  Set virtualProtectedLessonId in a local environment provisioned with this fixture.
}
