meta {
  name: Rotate Physical Device Secret
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admin/physical/devices/{{physicalDeviceId}}/rotate-secret
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("physicalDeviceSecret", res.getBody().secret);
  }
}

docs {
  #44, US-PHYSICAL-007 escenario 3. Run "Register Physical Device" first to
  populate {{physicalDeviceId}}.

  Success contract: 200 with a new raw secret exactly once, under `secret`.
  The previously issued secret's hash no longer validates.
  Error contract:
    400 INVALID_REQUEST   → malformed deviceId
    401                   → no bearer token
    403                   → authenticated role other than ADMIN
    404 DEVICE_NOT_FOUND  → unknown deviceId
    409 DEVICE_REVOKED    → device is REVOKED — rotation is terminally rejected
}

assert {
  res.status: eq 200
}
