meta {
  name: QR Check-in
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/physical/sessions/{{physicalSessionId}}/check-ins
  body: json
  auth: none
}

body:json {
  {
    "type": "QR",
    "qrCredentials": "{{physicalQrCredentials}}",
    "deviceId": "reader-1",
    "deviceToken": "{{physicalDeviceToken}}"
  }
}

docs {
  #38, US-PHYSICAL-001 escenario 2. Public at the filter level (`permitAll`)
  — the door reader authenticates with `deviceToken`, a shared secret
  verified inside the use case, never a Bearer token. `qrCredentials` comes
  from `POST /access-qr` (a Bearer-authenticated student endpoint, not in
  this folder).

  Validation order before touching Redis: deviceToken, QR shape, sessionId
  match, signature, expiry, session existence/window, confirmed capacity
  assignment. Only a request that clears all of those reaches the locks.

  Success contract: 201 on the first valid scan, 200 on any idempotent
  replay of the same QR — the attendance row count never grows on replay.
  Error contract:
    400 INVALID_REQUEST / INVALID_QR_CREDENTIAL → malformed body or QR bound
        to a different session
    401 INVALID_DEVICE_TOKEN
    403 SESSION_CANCELLED | OUTSIDE_CHECK_IN_WINDOW | CAPACITY_ASSIGNMENT_REQUIRED
    404 SESSION_NOT_FOUND
    409 ALREADY_PROCESSING
    410 EXPIRED_QR_CREDENTIAL
    503 CHECK_IN_DEGRADED (Redis unavailable, fail-closed)
}

assert {
  res.status: eq 201
}
