meta {
  name: Create Physical Course
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/physical/courses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "title": "Salsa Intermedio",
    "description": "Curso de salsa para nivel intermedio",
    "professorId": "de000000-0000-4000-8000-000000000002",
    "professorName": "María García",
    "dayOfWeek": "TUESDAY",
    "startTime": "23:00:00",
    "durationMinutes": 60,
    "level": "INTERMEDIATE",
    "capacity": 20
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("physicalCourseId", res.getBody().courseId);
  }
}

docs {
  US-PHYSICAL-005 escenario 1. Requires an ADMIN or INSTRUCTOR bearer token
  (log in first with a fixture that has one of those roles).

  `dayOfWeek` and `startTime` are UTC (ADR-0048, #729). The management client
  converts BOTH the weekday and the hour from the academy zone before sending,
  and converts them back to show them. This sample is "Tuesday 20:00 in Buenos
  Aires (UTC-3)" = `TUESDAY` 23:00:00 UTC; "Tuesday 22:00 in Buenos Aires" would
  be `WEDNESDAY` 01:00:00 UTC. A recurrence fixed in UTC is exact only for zones
  without daylight saving time.

  `professorId` is the demo instructor (profesor@menta.dance). An ADMIN MUST send
  it; an INSTRUCTOR may omit it (the course is assigned to themselves) or send
  their own id, and only an ADMIN may set an arbitrary one.

  Es obligatorio para el ADMIN (#743): sin `professorId` responde `400
  PROFESSOR_REQUIRED` y el curso ya no se asigna al admin por omisión. Ejemplo
  de la respuesta de error:

    {
      "type": "https://menta.dance/problems/professor_required",
      "title": "Bad Request",
      "status": 400,
      "detail": "professorId is required when an administrator creates a course.",
      "code": "PROFESSOR_REQUIRED"
    }

  Success contract: 201 with the full PhysicalCourseManagementResponse.
  Error contract:
    400 PROFESSOR_MISMATCH → INSTRUCTOR supplied someone else's professorId
    400 PROFESSOR_REQUIRED → ADMIN omitted professorId
    403                     → role is neither ADMIN nor INSTRUCTOR
}

assert {
  res.status: eq 201
}
