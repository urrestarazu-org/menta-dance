<?xml version="1.0" encoding="UTF-8"?>
<!--
  Diagnostic-only logging for the open Testcontainers "Connection refused" investigation
  (see docs/TESTCONTAINERS-CONNECTION-REFUSED-INVESTIGATION.md). Surfaces Testcontainers'
  own container lifecycle logs (creation, startup, reuse) to the test report's captured
  output, which is otherwise silent under this module's default logging.

  TODO(v1.0): remove this file before the production release once the root cause of the
  MySQL container dying between test classes is found and fixed — it exists purely to
  diagnose that open issue, not as permanent test infrastructure.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.testcontainers" level="DEBUG"/>
    <logger name="com.github.dockerjava" level="DEBUG"/>
    <logger name="tc" level="DEBUG"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
